NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are also supported via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only in `npm run dev`; production builds disable the simulation regardless of this flag.
ENABLE_DEV_PAYMENTS=false
# Server-only. Needed only for development payment simulation and seed script. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Explicitly opt in before inserting development fixtures.
ALLOW_DEV_SEED=false
# Optional integration test credentials (dedicated local/test project only)
TEST_OWNER_EMAIL=
TEST_RENTER_EMAIL=
TEST_PASSWORD=
ALLOW_DEV_INTEGRATION=false
TEST_OWNER_PASSWORD=
TEST_RENTER_PASSWORD=
